<?xml version="1.0" encoding="UTF-8"?>

<SarDsiConfig>
    <!-- use for sar uncouple framework -->
    <sarVersion>2</sarVersion>

    <!-- only use for CN -->
    <deviceSarConfig device_name="organ">
        <prop prop_name="ro.boot.hwc">CN</prop>
        <!-- receiver,hotSpot(wifi_spot,(bluetooth,bluetooth_pan)),sarsensor1,sarsensor2,mcc,wifi,cable,hall,usb,lab,white_list,hall2,sarsensor3 -->
        <listeners>000000000001000</listeners>
        <!-- lab -->
        <dsimap value="0">1</dsimap>
        <dsimap value="1">2</dsimap>
    </deviceSarConfig>

    <!-- only use for India -->
    <deviceSarConfig device_name="organ">
        <prop prop_name="ro.boot.hwc">India</prop>
        <!-- receiver,hotSpot(wifi_spot,(bluetooth,bluetooth_pan)),sarsensor1,sarsensor2,mcc,wifi,cable,hall,usb,lab,white_list,hall2,sarsensor3 -->
        <listeners>000011000000001</listeners>
        <!-- sarsensor1,sarsensor2,sarsensor3 -->
        <dsimap value="FFF">4</dsimap>
    </deviceSarConfig>

    <!-- only use for Global -->
    <deviceSarConfig device_name="organ">
        <prop prop_name="ro.boot.hwc">Global</prop>
        <!-- receiver,hotSpot(wifi_spot,(bluetooth,bluetooth_pan)),sarsensor1,sarsensor2,mcc,wifi,cable,hall,usb,lab,white_list,hall2,sarsensor3 -->
        <listeners>000010000000001</listeners>
        <!-- sarsensor1,sarsensor3 -->
        <dsimap value="01">1</dsimap>
        <dsimap value="10">2</dsimap>
        <dsimap value="00">3</dsimap>
        <dsimap value="11">4</dsimap>
    </deviceSarConfig>

    <!-- default configuration. -->
    <deviceSarConfig device_name="organ">
        <prop prop_name="ro.boot.hwc">default</prop>
        <prop prop_name="ro.product.mod_device">default</prop>
        <listeners>100000000000000</listeners>
        <!-- receiver -->
        <dsimap value="1">1</dsimap>
        <dsimap value="0">2</dsimap>
    </deviceSarConfig>

</SarDsiConfig>
